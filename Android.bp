package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "selogger_defaults",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}

cc_binary {
    name: "selogger",
    defaults: ["selogger_defaults"],
    vendor: true,
    srcs: [
        "src/android/audit_rate.cpp",
        "src/android/control.cpp",
        "src/android/daemon.cpp",
        "src/android/logd_reader.cpp",
        "src/main.cpp",
    ],
    static_libs: ["libselogger_core"],
    shared_libs: [
        "libbase",
        "libcutils",
    ],
    init_rc: ["selogger.rc"],
    required: ["selogger.conf"],
}

prebuilt_etc {
    name: "selogger.conf",
    src: "config/selogger.conf",
    vendor: true,
}

cc_library_static {
    name: "libselogger_core",
    defaults: ["selogger_defaults"],
    vendor: true,
    host_supported: true,
    srcs: [
        "src/analyze/macros.cpp",
        "src/analyze/policy_db.cpp",
        "src/analyze/rulegen.cpp",
        "src/avc.cpp",
        "src/collector.cpp",
        "src/config.cpp",
        "src/events.cpp",
        "src/journal.cpp",
        "src/label/files.cpp",
        "src/label/init_daemons.cpp",
        "src/label/labeler.cpp",
        "src/label/plan.cpp",
        "src/label/properties.cpp",
        "src/label/services.cpp",
        "src/tuple.cpp",
    ],
    export_include_dirs: ["src"],
    shared_libs: ["libbase"],
}

cc_test_host {
    name: "selogger_tests",
    defaults: ["selogger_defaults"],
    srcs: ["tests/*_test.cpp"],
    static_libs: ["libselogger_core"],
    shared_libs: ["libbase"],
    test_suites: ["general-tests"],
}
