package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "selogger_defaults",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}

cc_binary {
    name: "selogger",
    defaults: ["selogger_defaults"],
    vendor: true,
    srcs: ["src/main.cpp"],
    static_libs: ["libselogger_core"],
    shared_libs: ["libbase"],
}

cc_library_static {
    name: "libselogger_core",
    defaults: ["selogger_defaults"],
    vendor: true,
    host_supported: true,
    srcs: [
        "src/avc.cpp",
        "src/journal.cpp",
        "src/tuple.cpp",
    ],
    export_include_dirs: ["src"],
    shared_libs: ["libbase"],
}

cc_test_host {
    name: "selogger_tests",
    defaults: ["selogger_defaults"],
    srcs: ["tests/*_test.cpp"],
    static_libs: ["libselogger_core"],
    shared_libs: ["libbase"],
    test_suites: ["general-tests"],
}
